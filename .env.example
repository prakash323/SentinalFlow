# Copy to .env (git-ignored) and fill in real values. Never commit .env.
#   copy .env.example .env

# --- Database (required) ---
# Must match the password the existing postgres-data volume was initialised with.
DB_PASSWORD=change-me

# --- Console / API sign-in (optional; application.yml has dev-only placeholders) ---
# SECURITY_ADMIN_USERNAME=admin
# SECURITY_ADMIN_PASSWORD=change-me
# SECURITY_ANALYST_USERNAME=analyst
# SECURITY_ANALYST_PASSWORD=change-me

# --- AI assistant (optional) ---
# Without a key the AI endpoints answer 503 AI_PROVIDER_UNAVAILABLE; nothing else is affected.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_TEMPERATURE=0.2

# --- ML service (optional) ---
# ML_DEPLOYMENT_TZ=UTC
# ML_DEDUP_CACHE_SIZE=10000
